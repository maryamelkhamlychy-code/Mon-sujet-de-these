@article{roila_antimicrobial_2016-1,
	title = {Antimicrobial {Activity} of {Olive} {Mill} {Wastewater} {Extract} {Against} {Pseudomonas} {Fluorescens} {Isolated} from {Mozzarella} {Cheese}},
